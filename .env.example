# Copy to .env.local (gitignored) and fill in. Never commit real values.
# Use TEST keys while building — they cannot move real money.
#
# Only the first two come FROM Stripe. The rest are either generated by you or
# printed by the Stripe CLI, which is why you will not find them in the
# dashboard's API keys page.

# --- from Stripe → Developers → API keys (toggle to Test mode first) ---
STRIPE_SECRET_KEY=sk_test_...

# Not actually used yet. Stripe Checkout redirects to Stripe's own hosted page,
# so the publishable key is not needed. Kept here only in case the payment form
# is ever embedded in the site instead.
STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- printed by the Stripe CLI, not the dashboard ---
# stripe listen --forward-to localhost:5173/api/stripe-webhook
# In production it comes from the webhook endpoint you add in the dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- generated by you, nothing to do with Stripe ---
# Any long random string. Signs payment links so the dates in a link cannot be
# edited by the guest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_LINK_SECRET=

# Protects /api/create-payment-link, which mints valid payment links.
# Generate the same way. Only the villa should ever have this.
ADMIN_TOKEN=

# OPTIONAL, and normally left empty. This is a SUFFIX appended to the account's
# own statement descriptor, not a replacement for it. The Stripe account already
# says "SEAVIEW MIRAGE"; setting this produced "SEAVIEW MI* SEA VIEW M" on the
# guest's statement. Leave blank unless a suffix genuinely adds something.
STATEMENT_DESCRIPTOR=

# --- the villa dashboard at /admin ---
#
# Storage for rates, seasons, manual holds and booking statuses. Create a store
# under Vercel → Storage → Blob and this is injected automatically; locally,
# copy it from there. Without it the dashboard can READ (settings fall back to
# the defaults in shared/settings.mjs) but cannot SAVE.
BLOB_READ_WRITE_TOKEN=

# Generate both of these with:
#   npm run admin:password
#
# It prints a strong password once and never stores it — send that to the villa,
# and put the hash here. Losing the password means running the command again.
ADMIN_PASSWORD_HASH=

# Signs the admin session cookie. Must be 32+ characters. Changing it signs
# everyone out, which is how you revoke access if the password gets out.
ADMIN_SESSION_SECRET=

# Optional. Set on production so payment links always point at the real domain
# rather than a Vercel preview URL.
PUBLIC_SITE_URL=
